{
  "name": "codex-reset",
  "version": "2.0.0",
  "private": true,
  "description": "Codex 重置 — 自持台账的重置记录与 24–48 小时历史节奏预测。运行时零第三方接口，模型与数据都在仓库里。",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "probe": "node tools/probe.js",
    "check": "node tools/check.js",
    "check:server": "node tools/check-server.js",
    "check:deploy": "node tools/check-deploy.js",
    "deploy": "bash deploy/remote-deploy.sh",
    "check:seo": "node tools/check-seo.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
